NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://{{ mongodb_user }}:{{ mongodb_password }}@{{ mongodb_host }}:{{ mongodb_port }}/{{ mongodb_database }}?authSource=admin
JWT_SECRET={{ vault_jwt_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGINS=https://{{ domain }}
REDIS_HOST=127.0.0.1
REDIS_PORT={{ redis_port }}
LOG_LEVEL=info
FRONTEND_URL=https://{{ domain }}
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
MAIL_FROM=noreply@{{ domain }}
